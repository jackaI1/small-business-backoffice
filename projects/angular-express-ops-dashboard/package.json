{
  "name": "angular-express-ops-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "start": "node server/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:venue && npm run build --workspace server && npm run build --workspace web",
    "lint": "eslint .",
    "test": "npm run test:api && npm run test:unit",
    "test:api": "node --test server/*.node-test.mjs && npm run test --workspace server",
    "test:unit": "node scripts/unit.mjs && npm run test --workspace web -- --watch=false",
    "test:e2e": "playwright test",
    "seed": "npm run seed --workspace server",
    "build:venue": "ng build",
    "test:smoke": "node --test scripts/smoke.mjs",
    "test:browser": "node --test scripts/browser-check.mjs"
  },
  "dependencies": {
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/forms": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/router": "^20.3.35",
    "express": "^5.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.35",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/jasmine": "~5.1.9",
    "angular-eslint": "^20.7.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jasmine-core": "~5.9.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "workspaces": [
    "server",
    "web"
  ]
}
