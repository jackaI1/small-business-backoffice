            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = ReadCsv(\"dim_date\"),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"date\", type date}, {\"year\", Int64.Type}, {\"month\", Int64.Type}, {\"month_name\", type text}, {\"weekday_number\", Int64.Type}, {\"weekday\", type text}, {\"week_start\", type date}, {\"is_future\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
