            "sourceColumn": "wape",
            "summarizeBy": "none"
          },
          {
            "name": "bias",
            "dataType": "double",
            "sourceColumn": "bias",
            "summarizeBy": "none"
          },
          {
            "name": "n",
            "dataType": "int64",
            "sourceColumn": "n",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_metrics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = ReadCsv(\"fact_metrics\"),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"region_id\", type text}, {\"phase\", type text}, {\"model\", type text}, {\"selected\", Int64.Type}, {\"mae\", type number}, {\"rmse\", type number}, {\"wape\", type number}, {\"bias\", type number}, {\"n\", Int64.Type}}, \"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "dim_date",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
