{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "demand_trend",
  "position": {
    "x": 20,
    "y": 140,
    "z": 0,
    "height": 360,
    "width": 1240,
    "tabOrder": 0
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "date"
                }
              },
              "queryRef": "dim_date.date",
              "nativeQueryRef": "date"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_demand"
                    }
                  },
                  "Property": "Actual Tickets"
                }
              },
              "queryRef": "fact_demand.Actual Tickets",
              "nativeQueryRef": "Actual Tickets"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_demand"
                    }
                  },
                  "Property": "Forecast Tickets"
                }
              },
              "queryRef": "fact_demand.Forecast Tickets",
              "nativeQueryRef": "Forecast Tickets"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true
  }
}
